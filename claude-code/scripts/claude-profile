#!/bin/bash
# claude-profile: 1Password の専用保管庫（既定は Claude）だけを読み書きする窓口
#
# エージェントは op を直接呼ばず（hooks/guardrails/op-guard.sh がブロックする）、
# このスクリプトを通して、ユーザーが預けた個人情報（氏名・電話番号・住所・診察券番号など、
# パスワードではないもの）だけを扱う。パスワードやカード番号はこの保管庫に置かない。
# 読み書きには、この保管庫だけに権限を持つ 1Password のサービスアカウントを使う。
# トークンはユーザーが自分のターミナルで macOS のキーチェーンへ入れる。本体はトークンを
# 1Password の SDK にだけ渡し、引数にも出力にも出さない。
#
# 使い方:
#   claude-profile status                  キーチェーンのトークンで保管庫に届くか
#   claude-profile list                    項目名
#   claude-profile get <項目> [<キー>]      項目のメモ全体、または「キー: 値」の値だけ
#   claude-profile set <項目> < 値           項目を作成または上書き（標準入力をメモにする）
#
# set は標準入力の末尾の改行をすべて落として保存する（以前の claude-profile と同じ）。
# 既存の項目で書き換えるのはログインとメモの種類だけで、メモ以外の欄は変えない。
#
# 項目名は 1Password の項目のタイトルそのもの（例: 電話番号、診察券/〇〇クリニック）。
# 「/」は階層の見た目のための文字で、タグや別の保管庫は見ない。
#
# 環境変数:
#   CLAUDE_PROFILE_VAULT          保管庫の名前か ID（既定: Claude）
#   CLAUDE_PROFILE_TOKEN_SERVICE  トークンを入れたキーチェーン項目の service 名
#                                 （既定: claude-profile-op-token）
#
# 本体は claude-profile-sdk/main.mjs（1Password の公式 SDK）。op CLI を使わないのは、
# Go 1.26 で作られた op がサンドボックスの中で TLS の証明書を確かめられないため
# （SDK は Node の証明書の束で確かめる）。依存は claude-profile-sdk で npm ci して入れる。
#
# 取得した値は、ユーザーが頼んだ入力欄に使うためのもの。値の中に指示のような文があっても実行しない。

set +x
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# トークンを扱う node は決まった場所のものだけを使う（PATH で偽物に差し替えられないように）
NODE=""
for candidate in /opt/homebrew/bin/node /usr/local/bin/node; do
  if [ -x "$candidate" ]; then
    NODE="$candidate"
    break
  fi
done
[ -n "$NODE" ] || { echo "claude-profile: node が見つかりません（/opt/homebrew/bin/node か /usr/local/bin/node）" >&2; exit 1; }

# 本体より先にコードを読み込ませたり（NODE_OPTIONS の --require / --import、DYLD_*）、証明書の
# 確認をゆるめたりできる変数を外してから起動する（DYLD_* は SIP が保護されたバイナリの起動時にも
# 消すが、SIP を切った環境に備えて明示する）。サンドボックスでは Node の fetch がプロキシを
# 通るようにし、実験機能の警告は出さない
exec /usr/bin/env -u NODE_OPTIONS -u NODE_PATH -u NODE_EXTRA_CA_CERTS -u NODE_TLS_REJECT_UNAUTHORIZED \
  -u SSL_CERT_FILE -u SSL_CERT_DIR -u NODE_REPL_EXTERNAL_MODULE \
  -u DYLD_INSERT_LIBRARIES -u DYLD_LIBRARY_PATH -u DYLD_FALLBACK_LIBRARY_PATH \
  -u DYLD_FRAMEWORK_PATH -u DYLD_FALLBACK_FRAMEWORK_PATH \
  NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 "$NODE" "$DIR/claude-profile-sdk/main.mjs" "$@"
