#!/usr/bin/env python3
"""Deterministic Value Compiler evaluator for contract tests."""

from __future__ import annotations

import json
import os
import pathlib
import sys


request = json.load(sys.stdin)
capture = os.environ.get("FLIGHT_RECORDER_TEST_VALUE_CAPTURE")
if capture:
    with pathlib.Path(capture).open("a", encoding="utf-8") as stream:
        stream.write(
            json.dumps(request, sort_keys=True, separators=(",", ":")) + "\n"
        )

counter = os.environ.get("FLIGHT_RECORDER_TEST_VALUE_COUNT")
if counter:
    path = pathlib.Path(counter)
    try:
        count = int(path.read_text(encoding="utf-8"))
    except (FileNotFoundError, ValueError):
        count = 0
    path.write_text(str(count + 1), encoding="utf-8")


def evidence_items(value: object) -> list[dict[str, object]]:
    result: list[dict[str, object]] = []
    if isinstance(value, dict):
        item = value.get("evidence_id")
        if isinstance(item, str) and item.startswith("sha256:"):
            result.append(value)
        for nested in value.values():
            result.extend(evidence_items(nested))
    elif isinstance(value, list):
        for nested in value:
            result.extend(evidence_items(nested))
    unique: dict[str, dict[str, object]] = {}
    for item in result:
        unique.setdefault(str(item["evidence_id"]), item)
    return list(unique.values())


available = evidence_items(request.get("packet"))


def support_for(*needles: str) -> list[str]:
    for item in available:
        serialized = json.dumps(item, sort_keys=True).lower()
        if any(needle in serialized for needle in needles):
            return [str(item["evidence_id"])]
    return []


support = {
    "goal_achievement": support_for("meaning.outcome", "goal_achievement"),
    "deliverable_quality": support_for("meaning.verification", "quality"),
    "learning": support_for("meaning.reusable_learning", "reusable_learning"),
}
if os.environ.get("FLIGHT_RECORDER_TEST_VALUE_WRONG_AXIS_REFERENCE") == "1":
    support["learning"] = support["goal_achievement"]

states = {
    "goal_achievement": "positive",
    "deliverable_quality": "positive",
    "learning": "positive",
    "risk_reduction": "unknown",
    "reuse_potential": "unknown",
    "decision_leverage": "unknown",
    "attention_saved": "unknown",
    "rework": "unknown",
}
primitives = {}
for name, state in states.items():
    references = support.get(name, [])
    unknown = state == "unknown" or not references
    primitives[name] = {
        "state": "unknown" if unknown else state,
        "summary": (
            "No grounded signal is available for this value dimension."
            if unknown
            else f"Grounded evidence supports the {name.replace('_', ' ')} signal."
        ),
        "confidence": "low" if unknown else "high",
        "evidence_references": [] if unknown else references,
    }

json.dump(
    {
        "schema_version": 1,
        "primitives": primitives,
        "measured_cost_microusd": int(
            os.environ.get("FLIGHT_RECORDER_TEST_VALUE_COST", "6000")
        ),
    },
    sys.stdout,
    sort_keys=True,
    separators=(",", ":"),
)
