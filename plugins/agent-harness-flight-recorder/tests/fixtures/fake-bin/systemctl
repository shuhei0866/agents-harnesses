#!/bin/sh
set -eu

: "${FLIGHT_RECORDER_SCHEDULER_CALL_LOG:?}"
: "${FLIGHT_RECORDER_SCHEDULER_MANAGER_STATE:?}"
{
  printf 'systemctl'
  printf '\t%s' "$@"
  printf '\n'
} >>"$FLIGHT_RECORDER_SCHEDULER_CALL_LOG"

if [ "${2:-}" = "show" ]; then
  identifier=""
  for argument in "$@"; do
    case "$argument" in
      -*) ;;
      show) ;;
      *) identifier="$argument" ;;
    esac
  done
  fragment=""
  if [ -f "$FLIGHT_RECORDER_SCHEDULER_MANAGER_STATE" ]; then
    fragment=$(awk -F '	' -v name="$identifier" \
      '$1 == name { print $2 }' "$FLIGHT_RECORDER_SCHEDULER_MANAGER_STATE")
  fi
  if [ -n "$fragment" ]; then
    printf 'LoadState=loaded\nFragmentPath=%s\n' "$fragment"
  else
    printf 'LoadState=not-found\nFragmentPath=\n'
  fi
  exit 0
fi

case "${2:-}" in
  daemon-reload)
    units="${XDG_CONFIG_HOME}/systemd/user"
    : >"$FLIGHT_RECORDER_SCHEDULER_MANAGER_STATE"
    for identifier in \
      agent-harness-flight-recorder-sync.service \
      agent-harness-flight-recorder-sync.timer; do
      if [ -f "$units/$identifier" ]; then
        printf '%s\t%s\n' "$identifier" "$units/$identifier" \
          >>"$FLIGHT_RECORDER_SCHEDULER_MANAGER_STATE"
      fi
    done
    ;;
  enable)
    requested=""
    for argument in "$@"; do
      case "$argument" in
        -*) ;;
        enable) ;;
        *) requested="$argument" ;;
      esac
    done
    [ "$requested" = "agent-harness-flight-recorder-sync.timer" ]
    ;;
  disable)
    : >"$FLIGHT_RECORDER_SCHEDULER_MANAGER_STATE"
    ;;
esac
